{
  "name": "lista-de-tarefas",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run banco:redefinir",
    "start": "concurrently --kill-others --names \"Aplicação,API\" --prefix-colors \"cyan,magenta\" \"npm run start:app\" \"npm run start:api\"",
    "start:app": "ng serve",
    "start:api": "json-server banco.json --port 3000",
    "banco:redefinir": "node scripts/redefinir-banco.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "~22.1.8",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "~22.1.8",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "json-server": "^1.0.0-beta.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
